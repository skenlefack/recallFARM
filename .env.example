# ---- RecallFarm : variables d'environnement de la pile docker compose ----
# Copier en .env et remplacer chaque valeur marquée CHANGE_ME. Ne jamais committer .env.

# Exposition
HTTP_PORT=8080
NODE_ENV=production
TZ=Africa/Douala
CORS_ORIGINS=http://localhost:8080

# Images (CI / registre)
REGISTRY=recallfarm
TAG=latest

# Base de données
POSTGRES_DB=recallfarm
POSTGRES_USER=recallfarm
POSTGRES_PASSWORD=CHANGE_ME_pg_password

# Redis (verrous de l'ordonnanceur, limitation de débit)
REDIS_PASSWORD=CHANGE_ME_redis_password

# Jetons (générer : openssl rand -base64 48)
JWT_ACCESS_SECRET=CHANGE_ME_access
JWT_REFRESH_SECRET=CHANGE_ME_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Clés Ed25519 (packs, droits, certificats QR) : générées au premier démarrage dans le volume apikeys
KEYS_DIR=/app/keys

# Données de démonstration (comptes +23769000000x) — mettre false en production
SEED_ON_START=true
OTP_DEV_ECHO=true

# Fournisseurs : simulator | http
SMS_PROVIDER=simulator
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=RecallFarm
WHATSAPP_PROVIDER=simulator
PAYMENT_PROVIDER=simulator
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_hmac

# Sauvegardes (profil backup)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Connecteurs parametrables (ADR-002, infra/providers/README.md)
# SMS_PROVIDER / WHATSAPP_PROVIDER / PAYMENT_PROVIDER = connector pour utiliser un agregateur decrit en JSON
PROVIDERS_CONFIG_FILE=
PUBLIC_API_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080
