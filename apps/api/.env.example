# ---- Runtime --------------------------------------------------------------
NODE_ENV=development            # production disables /v1/dev/* and requires the secrets below
PORT=3000                       # HTTP port (all routes under /v1)
TZ=Africa/Douala                # business dates (reminders, "today") are computed in this zone

# ---- Storage --------------------------------------------------------------
DATABASE_URL=postgres://recallfarm:recallfarm@localhost:5432/recallfarm
TEST_DATABASE_URL=postgres://recallfarm:recallfarm@localhost:5432/recallfarm_test   # e2e only (schema is reset!)
REDIS_URL=                      # e.g. redis://localhost:6379 — empty = in-memory locks/rate limits (single instance)
DB_POOL_MAX=10

# ---- Auth -----------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_DEV_ECHO=true               # POST /auth/otp/request returns dev_code (never in production)
OTP_MAX_PER_WINDOW=3            # OTP requests per number…
OTP_WINDOW_S=900                # …per 15 minutes

# ---- Keys & parameter packs ------------------------------------------------
KEYS_DIR=./var/keys             # Ed25519 key pair (ed25519-private.pem / ed25519-public.pem), generated if absent — mount a volume
PACKS_DIR=../../packages/params/packs      # source packs loaded/signed at start and by the seed
VECTORS_DIR=../../packages/params/vectors  # shared test vectors (studio "test")
EXPORTS_DIR=./var/exports       # CSV exports and personal data exports

# ---- Channels ---------------------------------------------------------------
SMS_PROVIDER=simulator          # simulator | http
SMS_HTTP_URL=                   # http provider: POST {from,to,text}
SMS_HTTP_TOKEN=                 # bearer token for the aggregator
SMS_SENDER_ID=RecallFarm
WHATSAPP_PROVIDER=simulator
INBOUND_SECRET=                 # optional shared secret for /inbound/sms and /inbound/ussd (header X-Inbound-Secret)

# ---- Payments ---------------------------------------------------------------
PAYMENT_PROVIDER=simulator      # simulator (orange|mtn interfaces exist but are not wired)
PAYMENT_WEBHOOK_SECRET=change-me-webhook   # HMAC-SHA256 hex of the raw body, header X-Signature
PAYMENT_SIM_AUTOCONFIRM_MS=5000 # simulator auto-confirm delay (0 = manual via /v1/dev/payments/:id/confirm)

# ---- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
THROTTLE_LIMIT=300              # requests per THROTTLE_TTL_S per IP (global)
THROTTLE_TTL_S=60
PUBLIC_VERIFY_URL=http://localhost:8080/verifier   # base URL encoded in certificate QR codes

# ---- Jobs -------------------------------------------------------------------
SCHEDULER_ENABLED=true          # notification scheduler + alert escalation (every minute, Redis lock)
SEED_ON_START=false             # container: run the idempotent demo seed after migrations

# ---- Tools ------------------------------------------------------------------
API_URL=http://localhost:3000/v1   # used by npm run simulate:iot
INTERVAL_S=30
