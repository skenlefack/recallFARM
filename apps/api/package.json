{
  "name": "@recallfarm/api",
  "version": "0.1.0",
  "private": true,
  "description": "RecallFarm API (NestJS 10, TypeORM, PostgreSQL 16)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e:cov": "jest --config test/jest-e2e.config.js --runInBand --coverage",
    "migration:run": "node -r ts-node/register/transpile-only src/scripts/migrate.ts",
    "migration:run:prod": "node dist/scripts/migrate.js",
    "migration:revert": "node -r ts-node/register/transpile-only src/scripts/revert.ts",
    "seed": "node -r ts-node/register/transpile-only src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "simulate:iot": "node -r ts-node/register/transpile-only src/scripts/simulate-iot.ts",
    "openapi": "node -r ts-node/register/transpile-only src/scripts/export-openapi.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/typeorm": "10.0.2",
    "@types/qrcode": "^1.5.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "csv-parse": "5.6.0",
    "helmet": "7.2.0",
    "ioredis": "5.4.1",
    "jose": "5.9.6",
    "pdfkit": "0.15.2",
    "pg": "8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.26",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "body-parser": "1.20.9",
      "multer": "2.5.0",
      "express": {
        "body-parser": "1.20.9"
      }
    },
    "@nestjs/swagger": {
      "js-yaml": "4.3.2",
      "lodash": "4.18.1"
    }
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/pdfkit": "0.13.8",
    "@types/pg": "^8.11.10",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "rimraf": "5.0.10",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
